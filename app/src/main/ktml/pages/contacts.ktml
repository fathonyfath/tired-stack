<!DOCTYPE html>

import dev.fathony.tired.features.ContactsPage

<html lang="en" @view="$ContactsPage">
<app-layout title="Contacts">
    <h1 class="text-2xl font-bold">Contacts</h1>
    <p class="mt-2 text-gray-600">Search, scroll, add and delete, each as an HTMX request against SQLite.</p>

    <form hx-post="/contacts" hx-target="#contacts" hx-swap="afterbegin"
          hx-on::after-request="if (event.detail.successful) this.reset()" class="mt-6 flex gap-2">
        <input name="name" placeholder="Name" maxlength="100" required
               class="min-w-0 flex-1 rounded-md border bg-white px-3 py-2">
        <input name="email" type="email" placeholder="Email" maxlength="100" required
               class="min-w-0 flex-1 rounded-md border bg-white px-3 py-2">
        <button class="rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-700">Add</button>
    </form>

    <input type="search" name="q" value="${view.query}" placeholder="Search by name or email"
           hx-get="/contacts" hx-trigger="input changed delay:300ms, search" hx-target="#contacts"
           hx-replace-url="true"
           hx-on::config-request="if (!event.detail.parameters.get('q')) event.detail.parameters.delete('q')"
           class="mt-4 w-full rounded-md border bg-white px-3 py-2">

    <ul id="contacts" class="mt-4 divide-y rounded-md border bg-white">
        <contact-list rows="${view.rows}"/>
    </ul>
</app-layout>
</html>
