{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "reviewers": [
    "fathonyfath"
  ],
  "packageRules": [
    {
      "description": "Merge the weekly non-major group once Check passes; majors still wait for review",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Maven Central rate-limits Mend's hosted runners, so look up Central artifacts on Google's mirror",
      "matchDatasources": [
        "maven"
      ],
      "registryUrls": [
        "https://maven-central.storage-download.googleapis.com/maven2/",
        "https://plugins.gradle.org/m2/"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "npm packages declared with webAssets { npm(\"name\", \"version\") }",
      "managerFilePatterns": [
        "/(^|/)build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "npm\\(\"(?<depName>[^\"]+)\",\\s*\"(?<currentValue>[^\"]+)\"\\)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "The Node.js version in the version catalog; node versioning only offers LTS releases",
      "managerFilePatterns": [
        "/(^|/)gradle/libs\\.versions\\.toml$/"
      ],
      "matchStrings": [
        "\\nnodejs = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ]
}
